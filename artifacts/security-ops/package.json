  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "EXPO_PACKAGER_PROXY_URL=https://$REPLIT_EXPO_DEV_DOMAIN EXPO_PUBLIC_DOMAIN=$REPLIT_DEV_DOMAIN EXPO_PUBLIC_API_BASE_URL=https://secureops-command.replit.app/api EXPO_PUBLIC_REPL_ID=$REPL_ID REACT_NATIVE_PACKAGER_HOSTNAME=$REPLIT_DEV_DOMAIN pnpm exec expo start --localhost --port $PORT",
    "build:native": "node scripts/build.js",
    "serve:native": "node server/serve.js",
    "build": "rm -rf web-dist && pnpm exec expo export --platform web --output-dir web-dist",
    "serve": "node server/serve-web.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "submit:ios": "./node_modules/.bin/eas submit --platform ios --profile production --latest"
  },
