{
  "expo": {
    "name": "SecureOps",
    "slug": "secureops",
    "owner": "justin.knox",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "secureops",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/images/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#080c18"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.replit.secureops",
      "buildNumber": "1",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "SecureOps uses your location to verify you are on-site when you clock in and to share your live position with dispatch while you are on shift.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "SecureOps uses your location in the background while you are clocked in so dispatch can be alerted if you leave your assigned site or trigger an emergency.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.replit.secureops",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#080c18"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://secureops.williamscouncilsg.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#c9a84c",
          "sounds": []
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow SecureOps to use your camera so you can snap a fresh photo of your TX security license, passport, or training certificates from the field.",
          "photosPermission": "Allow SecureOps to access your photo library so you can attach an existing image of your TX security license, passport, or training certificates."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "SecureOps uses your location in the background while you are clocked in so dispatch can be alerted if you leave your assigned site or trigger an emergency.",
          "isAndroidBackgroundLocationEnabled": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "452c8467-1a26-4e16-9b41-e5799d80023e"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/452c8467-1a26-4e16-9b41-e5799d80023e"
    }
  }
}
