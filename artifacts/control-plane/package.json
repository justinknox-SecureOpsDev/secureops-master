    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "catalog:",
    "@types/pg": "^8.18.0",
    "@types/supertest": "^7.2.0",
    "esbuild": "^0.27.3",
