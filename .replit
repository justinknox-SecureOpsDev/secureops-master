modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "vm"
run = ["node", "--enable-source-maps", "artifacts/api-server/dist/index.mjs"]
build = ["pnpm", "run", "build:vm"]

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "a11y-mobile"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "typecheck"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "security-headers"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "a11y"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "test"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "schema-drift"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "schema-drift-test"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "deps-install"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "front-door"

[[workflows.workflow]]
name = "a11y-mobile"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/scripts run a11y-mobile"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "typecheck"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm run typecheck"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "security-headers"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/scripts run check-security-headers"

[[workflows.workflow]]
name = "a11y"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/scripts run a11y"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "test"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm -r --if-present run test"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "schema-drift"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/scripts run check-schema-drift"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "schema-drift-test"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/scripts run test-schema-drift"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "deps-install"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm install --reporter=append-only"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "front-door"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/scripts run check-front-door"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "artifacts/permission-video: web"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=8082 BASE_PATH=/permission-video/ pnpm --filter @workspace/permission-video run dev"
waitForPort = 8082

[workflows.workflow.metadata]
outputType = "console"

[agent]
stack = "BEST_EFFORT_FALLBACK"
expertMode = true
integrations = ["github:1.0.0", "javascript_gemini_ai_integrations:2.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 80

[[ports]]
localPort = 8082
externalPort = 3002

[[ports]]
localPort = 9999
externalPort = 4200

[[ports]]
localPort = 22706
externalPort = 3000

[[ports]]
localPort = 22707
externalPort = 3003

[[ports]]
localPort = 25580
externalPort = 3001

[nix]
channel = "stable-25_05"
packages = []

[userenv]

[userenv.production]
PORT = "8080"
NODE_ENV = "production"
ALLOWED_ORIGINS = "https://wcsgisecureops.com"
APP_BASE_URL = "https://wcsgisecureops.com"

[userenv.shared]
GEOCODING_ENABLED = "true"
EMAIL_PROVIDER = "smtp"
DEMO_ADMIN_EMAIL = "justin.knox@williamscouncil.com"
SUPER_ADMIN_EMAILS = "justin.knox@williamscouncil.com"
ORG_DIRECTORY = "[{\"code\":\"wcsgi\",\"name\":\"Williams Council Security Group\",\"apiBaseUrl\":\"https://secureops-command.replit.app\"},{\"code\":\"wcsg\",\"name\":\"Williams Council Security Group\",\"apiBaseUrl\":\"https://secureops-command.replit.app\"},{\"code\":\"rgp\",\"name\":\"RGP\",\"apiBaseUrl\":\"https://rgpsecureopscommand.com\"}]"
ORG_CODE = "wcsgi"

[objectStorage]
defaultBucketID = "replit-objstore-932b0f1e-21e4-4a6f-a5f8-ab5a30523226"
