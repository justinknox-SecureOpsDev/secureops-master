modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "cloudrun"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 80

[[ports]]
localPort = 8082
externalPort = 3002

[[ports]]
localPort = 9999
externalPort = 4200

[[ports]]
localPort = 22706
externalPort = 3000

[[ports]]
localPort = 22707
externalPort = 3003

[[ports]]
localPort = 25580
externalPort = 3001

[nix]
channel = "stable-25_05"
packages = ["yakut", "eas-cli"]

[userenv]

[userenv.production]
SEED_DEMO_USERS = "false"
APP_BASE_URL = "https://security-operations-suite.replit.app"
ALLOWED_ORIGINS = "https://security-operations-suite.replit.app,https://secureops.williamscouncilsg.com"

[userenv.shared]
GEOCODING_ENABLED = "true"

[objectStorage]
defaultBucketID = "replit-objstore-932b0f1e-21e4-4a6f-a5f8-ab5a30523226"
